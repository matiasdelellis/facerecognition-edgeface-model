# Copy to .env (gitignored) and fill in a real key: openssl rand -base64 32
# The weights are licensed for non-commercial use only (see NOTICE.md).
# The service refuses to start until this is set to "non-commercial".
# Set it only if you accept those terms.
LICENSE_ACCEPTED=
API_KEY=some-super-secret-api-key

# Face detector: scrfd_500m (default), scrfd_10g (finds more small faces, ~4x slower)
# or yunet (MIT weights, but mixes more people with EdgeFace).
# DETECTOR=scrfd_500m

# Gunicorn processes, and threads each one gives to onnxruntime.
# GUNICORN_WORKERS=1
# MODEL_THREADS=1

# Host port.
# PORT=8080
